# Dashboard configuration. Copy to dashboard/.env for local use.
#
# The Atlas user here is SEPARATE from the trading system's. Give it readWrite
# on algotrade_paper only -- not "any database", so it can never see
# algotrade_dev or a future algotrade_prod.
MONGODB_URI=mongodb+srv://algotrade_dashboard:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=algotrade_paper
PORTFOLIO_ID=paper_momentum_v1_001

# Basic auth. The deployment URL is guessable and every page shows holdings,
# NAV and broker order ids. Minimum 12 characters, enforced at startup.
DASHBOARD_USER=akash
DASHBOARD_PASSWORD=

# Recording executions mutates the book. Off unless set deliberately.
# DASHBOARD_ALLOW_WRITES=true

# STRATEGY_VERSION=momentum_v1
