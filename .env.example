# algotrade -- local development configuration.
#
#   cp .env.example .env      then fill in the values
#   python -m algotrade.check_config
#
# .env is gitignored and must never be committed. In GitHub Actions these same
# names come from repository Secrets, and the process environment always wins
# over this file so a stale local copy cannot override CI.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# dev   -- local work. Telegram and the heartbeat are optional.
# paper -- simulated money, running unattended. Telegram and heartbeat REQUIRED.
# prod  -- real money. The only environment permitted to operate a live_ portfolio.
ENVIRONMENT=dev

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
# Atlas M0 is fine: this stores portfolio state only, never market history
# (~14 MB/year against a 512 MB tier).
#
# Atlas checklist:
#   - a database user with readWrite on THIS database only
#   - Network Access must allow 0.0.0.0/0 for GitHub Actions (runner IPs are
#     not stable). Compensate with a strong, single-purpose password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Defaults per environment: algotrade_dev | algotrade_paper | algotrade_prod.
# Set explicitly only for a scratch database -- pointing one environment at
# another's database is refused by validation.
MONGODB_DATABASE=algotrade_dev

# ---------------------------------------------------------------------------
# Telegram -- the operational interface
# ---------------------------------------------------------------------------
# Required for paper and prod: without it the system runs but cannot tell you
# anything, and the daily message's ABSENCE is one of the failure signals.
#
#   1. message @BotFather -> /newbot
#   2. add the bot to your channel or group as an admin that can post
#   3. get the chat id: https://api.telegram.org/bot<TOKEN>/getUpdates
#      (group ids are negative, e.g. -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Broker -- NOT USED YET
# ---------------------------------------------------------------------------
# No code places orders. Execution is manual: the system recommends, you trade,
# then you record the fills. These are here so the shape is settled before it
# is needed. Leave blank until automatic placement is actually built, and never
# put production broker credentials in a paper environment.
BROKER_NAME=zerodha
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=
BROKER_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Health monitoring -- the dead-man switch
# ---------------------------------------------------------------------------
# The ONLY monitor not hosted on the infrastructure it watches. If GitHub
# Actions is down, the repo is disabled, or the workflow is deleted, nothing
# in-system can alert you -- this can.
#
#   healthchecks.io (free tier, 20 checks)
#   period 1 day, grace 6 hours -> alerts ~26h after the last success, so a
#   weekend or holiday does not page you.
HEALTHCHECKS_PING_URL=

# Optional overrides. healthchecks.io models ONE check as one base URL with
# /start and /fail appended, and that is what the code derives by default --
# three separate URLs would be three separate checks, each with its own
# independent timeout, which is almost never what you want. Set these only if
# you genuinely run distinct checks or use a provider with a different shape.
# HEALTHCHECKS_START_URL=
# HEALTHCHECKS_SUCCESS_URL=
# HEALTHCHECKS_FAIL_URL=

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------
# Source is NSE's public archive; there is no key or endpoint to configure.
# Storage is tiered by mutation pattern (see the Phase 2 design):
#
#   data/archive/    frozen history  -- GitHub Release asset, restored by CI
#   data/sessions/   forward daily   -- COMMITTED to git, append-only
#   data/curated/    derived panel   -- a cache, rebuilt in ~21s, never committed
#
# Production needs ~320 sessions (12-1 momentum reaches back 252 + 21); the
# 16-year archive is for research and stays out of the production path.
#
# CURATED_MIN_SESSIONS=320

# ---------------------------------------------------------------------------
# Portfolio
# ---------------------------------------------------------------------------
# Format: {paper|live|shadow}_{strategy}_v{n}_{nnn}
# A live_ portfolio outside ENVIRONMENT=prod is refused.
DEFAULT_PORTFOLIO_ID=paper_momentum_v1_001

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# CHARGE_RESERVE_BPS=30          # withheld from investable cash so the last buy fits
# RECOMMENDATION_TTL_DAYS=3      # after this the signal is stale, not a decision
# ALGOTRADE_DRY_RUN=false        # compute everything, write nothing
